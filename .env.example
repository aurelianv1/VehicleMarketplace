# Copiază acest fișier în .env (care NU se comite) și schimbă SECRET_KEY.
# Valorile de mai jos sunt pentru dezvoltare locală.

# PostgreSQL (folosite de docker-compose.yml)
POSTGRES_USER=carmarket
POSTGRES_PASSWORD=carmarket
POSTGRES_DB=carmarket

DATABASE_URL=postgresql+psycopg://carmarket:carmarket@localhost:5432/carmarket

# Cheia cu care se semnează token-urile JWT. Generează una nouă cu:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=schimba-aceasta-cheie
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Originile frontend-ului care pot chema API-ul (cu cookie-uri)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Poze: folder relativ la backend/, limite per fișier și per anunț
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=5
MAX_IMAGES_PER_LISTING=15

# Jurnalul de activitate: backend/logs/activity.log
LOG_DIR=logs
# Cereri permise per IP pe minut (peste limită: 429). Pentru testele e2e se pornește
# backend-ul cu RATE_LIMIT_PER_MINUTE=100000 (vezi frontend/e2e/README.md)
RATE_LIMIT_PER_MINUTE=100

# În producție (HTTPS, în spatele Apache pe /api): COOKIE_SECURE=true, REFRESH_COOKIE_PATH=/api/auth
COOKIE_SECURE=false
REFRESH_COOKIE_PATH=/auth
